# API
PORT=43140
NODE_ENV=development

# Worker: mock outbox drain (K01). No Redis. Interval ms; 0 disables.
WORKER_PORT=43141
# OUTBOX_DRAIN_INTERVAL_MS=4000

# Optional Postgres. Unset = in-memory (lost on restart).
# Set DATABASE_URL in gitignored apps/api/.env or repo .env — never commit the real URL.
# Example (local docker only): postgres://magazakit:magazakit@127.0.0.1:5433/magazakit
# DATABASE_URL=

# Extra CORS origins (comma-separated) beyond Expo localhost / LAN / *.expo.dev
# CORS_ORIGINS=http://localhost:8081

# Firebase project magazam-app. ID tokens verified with Admin SDK (aud = magazam-app).
# Do not commit a service-account JSON or private key.
FIREBASE_PROJECT_ID=magazam-app
# Cloud / prod: GOOGLE_APPLICATION_CREDENTIALS=/path/outside/git/sa.json
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Trendyol — leave mock on until seller panel Integration Details exist.
# Live read (no writes): TRENDYOL_USE_MOCK=false plus the three values below.
# Host must be apigw.trendyol.com (not api.trendyol.com). Stage needs IP allowlist.
TRENDYOL_USE_MOCK=true
TRENDYOL_ENV=prod
TRENDYOL_BASE_URL=https://apigw.trendyol.com
TRENDYOL_SELLER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
# TRENDYOL_INTEGRATOR_NAME=SelfIntegration

# Other channels: Nest-only. Empty = CHANNEL_UNAVAILABLE (not connected).
# HEPSIBURADA_MERCHANT_ID=
# HEPSIBURADA_API_KEY=
# HEPSIBURADA_API_SECRET=
# HEPSIBURADA_ENV=prod
# HEPSIBURADA_USER_AGENT=
# HEPSIBURADA_INTEGRATOR_NAME=Magazam
# N11_APP_KEY=
# N11_APP_SECRET=
# SHOPIFY_SHOP=
# SHOPIFY_ACCESS_TOKEN=
# SHOPIFY_API_VERSION=2026-07
# WOOCOMMERCE_HOST=
# WOOCOMMERCE_CONSUMER_KEY=
# WOOCOMMERCE_CONSUMER_SECRET=
# CICEKSEPETI_API_KEY=
# CICEKSEPETI_ENV=prod
# IKAS_ACCESS_TOKEN=
# AMAZON_LWA_CLIENT_ID=
# AMAZON_LWA_CLIENT_SECRET=
# AMAZON_REFRESH_TOKEN=
# AMAZON_MARKETPLACE_ID=A33AVAJ2PDY3EV
# AMAZON_SP_HOST=https://sellingpartnerapi-eu.amazon.com
# AMAZON_USER_AGENT=Magazam/1.0 (Language=JavaScript)
# CHANNEL_ALLOW_PRIVATE_HOSTS=false
# Pazarama / Ticimax / IdeaSoft: no verified product paths — adapters stay blocked.
