# API
PORT=43140
NODE_ENV=development

# Worker (empty health process; no queue)
WORKER_PORT=43141

# Optional Postgres (API uses in-memory mock; compose is for later slices)
DATABASE_URL=postgres://magazakit:magazakit@127.0.0.1:5433/magazakit

# Firebase — ID token verification only (Admin SDK). Leave empty in local F0:
# authenticated routes return 401 AUTH_NOT_CONFIGURED; GET /health stays public.
# Do not commit service-account JSON or private keys.
FIREBASE_PROJECT_ID=
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Trendyol — leave empty. Defaults to in-memory mock (K01).
TRENDYOL_USE_MOCK=true
TRENDYOL_BASE_URL=https://api.trendyol.com
TRENDYOL_SELLER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
