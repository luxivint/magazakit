# API
PORT=43140
NODE_ENV=development

# Worker (empty health process; no queue)
WORKER_PORT=43141

# Optional Postgres (API uses in-memory mock; compose is for later slices)
DATABASE_URL=postgres://magazakit:magazakit@127.0.0.1:5433/magazakit

# Firebase project magazam-app. ID tokens are verified with Admin SDK (aud = magazam-app).
# Do not commit a service-account JSON or private key.
FIREBASE_PROJECT_ID=magazam-app
# Cloud / prod privileged Admin calls: point at a key file kept outside git.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/magazam-app-sa.json
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Trendyol — leave empty. Defaults to in-memory mock (K01).
TRENDYOL_USE_MOCK=true
TRENDYOL_BASE_URL=https://api.trendyol.com
TRENDYOL_SELLER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
