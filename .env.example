# API
PORT=43140
NODE_ENV=development

# Worker (empty health process; no queue)
WORKER_PORT=43141

# Optional Postgres. Uncomment to persist orgs, catalog, stock ledger, outbox.
# If unset, in-memory (lost on restart). Redis/BullMQ not required for F3 mock outbox.
# DATABASE_URL=postgres://magazakit:magazakit@127.0.0.1:5433/magazakit

# Extra CORS origins (comma-separated) beyond Expo localhost / LAN / *.expo.dev
# CORS_ORIGINS=http://localhost:8081

# Firebase project magazam-app. ID tokens verified with Admin SDK (aud = magazam-app).
# Do not commit a service-account JSON or private key.
FIREBASE_PROJECT_ID=magazam-app
# Cloud / prod: GOOGLE_APPLICATION_CREDENTIALS=/path/outside/git/sa.json
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Trendyol — leave empty. Defaults to in-memory mock (K01). Never sent to logs.
TRENDYOL_USE_MOCK=true
TRENDYOL_BASE_URL=https://api.trendyol.com
TRENDYOL_SELLER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
