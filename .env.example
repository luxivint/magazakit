# API
PORT=43140
NODE_ENV=development

# Worker: mock outbox drain (K01). No Redis. Interval ms; 0 disables.
WORKER_PORT=43141
# OUTBOX_DRAIN_INTERVAL_MS=4000

# Optional Postgres. Unset = in-memory (lost on restart).
# Set DATABASE_URL in gitignored apps/api/.env or repo .env — never commit the real URL.
# Example (local docker only): postgres://magazakit:magazakit@127.0.0.1:5433/magazakit
# DATABASE_URL=

# Extra CORS origins (comma-separated) beyond Expo localhost / LAN / *.expo.dev
# CORS_ORIGINS=http://localhost:8081

# Firebase project magazam-app. ID tokens verified with Admin SDK (aud = magazam-app).
# Do not commit a service-account JSON or private key.
FIREBASE_PROJECT_ID=magazam-app
# Cloud / prod: GOOGLE_APPLICATION_CREDENTIALS=/path/outside/git/sa.json
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Demo mock Trendyol feed without shop keys. Live TY keys come from Magaza bağla, not this file.
TRENDYOL_USE_MOCK=true

# AES-256-GCM wrapping key. NEVER copy a sample value. Generate:
#   openssl rand -hex 32
# Placeholder / short / passphrase keys are rejected at boot.
# CREDENTIALS_ENCRYPTION_KEY=

# Reverse proxy: honor X-Forwarded-Proto only from these hops/IPs (e.g. 1 or 10.0.0.1).
# Unset = ignore spoofable forwarded headers; require loopback or real TLS.
# TRUST_PROXY=

# CHANNEL_ALLOW_PRIVATE_HOSTS=false
# CHANNEL_HTTP_TIMEOUT_MS=15000
# Pazarama / Ticimax / IdeaSoft stay blocked (no verified REST paths).

# Cloudflare R2 (S3 API) — listing images. Leave unset to keep marketplace CDN URLs.
# Put real keys only in gitignored apps/api/.env — never commit them.
# R2_BUCKET=magazakit
# R2_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
