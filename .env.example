# API
PORT=43140
NODE_ENV=development

# Worker (empty health process; no queue in F0)
WORKER_PORT=43141

# Optional Postgres (F0 API uses in-memory mock; compose is for later slices)
DATABASE_URL=postgres://magazakit:magazakit@127.0.0.1:5433/magazakit

# Trendyol — leave empty. F0 defaults to the in-memory mock (K01).
# Do not commit real keys. Adapter never logs these values.
TRENDYOL_USE_MOCK=true
TRENDYOL_BASE_URL=https://api.trendyol.com
TRENDYOL_SELLER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
